  "quality_principles": {
    "analysis_correctness_required": true,
    "unknown_conditions_must_be_reported": true,
    "diagnostic_evidence_required": true,
    "unsupported_conditions_must_be_identified": true,
    "route_found_implies_reachable": false,
    "automatic_cloud_deployment_required": false,
    "stop_all_checks_on_first_blocker": false,
    "must_distinguish_packet_forwarding_from_diagnostic_continuation": true,
    "must_distinguish_predicted_and_conditional_paths": true,
    "must_not_invent_unresolved_paths": true,
    "must_report_unexamined_coverage": true,
    "must_preserve_existing_tests": true,
    "configuration_edges_are_not_packet_hops": true,
    "must_support_non_color_status_cues": true,
    "visual_edits_must_not_change_analysis": true,
    "must_distinguish_input_provenance_and_observations": true,
    "read_only_aws_collection_required": true,
    "must_protect_sensitive_input": true,
    "release_requires_full_acceptance_evidence": true
  },
  "mandatory_requirements": [
    {
      "id": "REQ-MULTI-001",
      "name": "non_stop_multi_issue_diagnostics",
      "classification": "must_have_architecture_requirement",
      "description": "Continue independently or conditionally evaluable checks after the first predicted blocker; aggregate multiple findings without inventing downstream packet paths.",
      "implementation_status": "bounded_session_diagnostics_implemented",
      "required_in": [
        "analysis_orchestration",
        "diagnostic_data_model",
        "visualization",
        "automated_tests"
      ]
    },
    {
      "id": "REQ-UI-VIEWS-001",
      "name": "separate_topology_and_packet_trace_views",
      "classification": "must_have_architecture_requirement",
      "decision_status": "approved",
      "implementation_status": "basic_three_views_implemented",
      "description": "Provide independently selectable Topology View and Packet Trace View, both consuming shared infrastructure identifiers and relevant diagnostic data. Do not present configuration edges as packet hops.",
      "required_in": [
        "visualization_architecture",
        "view_navigation",
        "shared_infrastructure_model",
        "automated_tests"
      ]
    },
    {
      "id": "REQ-UI-SEMANTICS-002",
      "name": "distinguish_predicted_path_and_conditional_checks",
      "classification": "must_have_visualization_requirement",
      "decision_status": "approved",
      "implementation_status": "basic_visual_trace_and_overlays_implemented",
      "description": "Render predicted packet movement, first blocker, conditional downstream checks and unexamined segments with unambiguous labels and non-color-only cues.",
      "required_in": [
        "packet_trace_view",
        "diagnostic_overlays",
        "accessibility_tests"
      ]
    },
    {
      "id": "REQ-UI-EDIT-003",
      "name": "interactive_topology_editing",
      "classification": "must_have_v1_release_requirement",
      "decision_status": "approved",
      "implementation_status": "planned",
      "description": "V1 requires resource drag, edge recalculation, containment constraints, VPC/subnet collapse/expand with hidden diagnostic summaries, and layout save/restore/reset keyed by input fingerprint and graph mode. Layout edits never change the infrastructure or verdict.",
      "required_in": [
        "visualization",
        "layout_state",
        "browser_e2e"
      ]
    },
    {
      "id": "REQ-AWS-001",
      "name": "aws_inventory_analysis",
      "classification": "must_have_v1_release_requirement",
      "decision_status": "approved",
      "implementation_status": "inventory_and_visualization_implemented_analysis_pending",
      "description": "Read-only AWS configuration collection and bounded static analysis with provenance, scope and unknown coverage; compare Reachability Analyzer and Flow Logs evidence separately.",
      "required_in": [
        "input_adapters",
        "analysis_orchestration",
        "integration_tests"
      ]
    },
    {
      "id": "REQ-WEB-001",
      "name": "stable_web_analysis_service",
      "classification": "must_have_v1_release_requirement",
      "decision_status": "approved",
      "implementation_status": "local_web_foundation_implemented_release_hardening_pending",
      "description": "V1 requires validated inputs, bounded requests, error recovery, prior snapshot retention, stale input and concurrency handling, sensitive data protection, deployment and operating documentation, and security/performance acceptance.",
      "required_in": [
        "web_service",
        "security",
        "performance",
        "browser_e2e"
      ]
    },
    {
      "id": "REQ-V1-001",
      "name": "release_acceptance",
      "classification": "must_have_v1_release_requirement",
      "decision_status": "approved",
      "implementation_status": "planned",
      "description": "V1 is complete only after the mandatory scope and acceptance gates are verified, not by test count or document revision alone.",
      "required_in": [
        "release_qa",
        "documentation",
        "support_matrix"
      ]
    }
  ],
